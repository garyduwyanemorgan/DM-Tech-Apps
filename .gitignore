# ── Secrets — NEVER commit (Supabase key, Clerk/Stripe/Anthropic keys live here) ──
# Globbed, not exact: a secrets.toml.bak / .orig / .save copy is just as dangerous.
.streamlit/secrets.toml*
.env
.env.*
*.env
*.key
*.bak
# ...but the placeholder-only template IS tracked (re-included after the globs
# above, which would otherwise swallow it via `.env.*`).
!.env.example

# ── Client lab reports & SOPs ──
# ~31 MB of PDFs/DOCX/images (one 16.6 MB PDF, one 7.3 MB PNG). They stay on disk
# but out of git: binaries bloat history permanently and git cannot diff them.
# Globbing the *contents*, not the directory, so the negation below still applies —
# git will not descend into an excluded directory to reconsider a file.
# The extraction/reporting protocol note IS tracked (real project documentation),
# and the three parser regression fixtures live in tests/fixtures/wimpey/.
Lab Reports Example/*
!Lab Reports Example/*.md

# Node / frontend build
node_modules/
frontend/node_modules/
dist/
frontend/dist/
*.tsbuildinfo

# setup_bundle.md contains real secrets — transfer by direct copy only, never push
setup_bundle.md

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.log
.venv/
.venv-codex/
venv/
.ipynb_checkpoints/

# Local data / outputs
backups/
reports/

# OS / editors
.DS_Store
Thumbs.db
.vscode/
.idea/
