# ── Secrets — NEVER commit (Supabase key, Clerk/Stripe/Anthropic keys live here) ──
# Globbed, not exact: a secrets.toml.bak / .orig / .save copy is just as dangerous.
.streamlit/secrets.toml*
.env
.env.*
*.env
*.key
*.bak

# Node / frontend build
node_modules/
frontend/node_modules/
dist/
frontend/dist/
*.tsbuildinfo

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.log
.venv/
venv/
.ipynb_checkpoints/

# Local data / outputs
backups/
reports/

# OS / editors
.DS_Store
Thumbs.db
.vscode/
.idea/
