# Copy to `.env` for local development and fill in real values.
# `.env` is gitignored; this template holds placeholders ONLY — never real keys.
#
# On Render there is no `.env`: the same names are set in the dashboard and
# declared in render.yaml. Resolution order is env -> .env -> secrets.toml
# (see core/config.py); the legacy .streamlit/secrets.toml still works locally
# until you finish moving values here.
#
# Names are mechanical: [section] key in the old TOML becomes SECTION_KEY.

# ── Supabase (required — without it the app serves sample data) ──
SUPABASE_URL=
SUPABASE_KEY=

# ── Clerk auth ──
# The LIVE publishable key is bound to clerk.gdm-enviro.com and is rejected on
# any other origin, so localhost uses the DEV pair below instead. When a dev
# publishable key is present the backend verifies tokens against that instance —
# it must name the same instance as frontend/.env.local's
# VITE_CLERK_DEV_PUBLISHABLE_KEY, or every request 401s.
CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_live_...
# Local only — must NEVER be set on Render, or production authenticates against
# the dev instance.
CLERK_DEV_PUBLISHABLE_KEY=pk_test_...
CLERK_DEV_SECRET_KEY=sk_test_...

# ── Anthropic (AI lab-report extraction, extract.py) ──
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# ── Payments ── 'checkout' (default) or 'stripe'
PAYMENT_PROVIDER=checkout
CHECKOUT_SECRET_KEY=
CHECKOUT_WEBHOOK_SECRET=
CHECKOUT_BILLING_COUNTRY=AE
# Only needed when PAYMENT_PROVIDER=stripe
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_STARTER=
# STRIPE_PRICE_GROWTH=
# STRIPE_PRICE_PROFESSIONAL=

# ── Gatekeeper ──
# Access requests are emailed here, and only this address may bootstrap itself
# as super_admin on first sign-in.
ADMIN_NOTIFY_EMAIL=
# Optional: without SMTP_HOST, access requests are logged to stderr not emailed.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── Misc ──
# Comma-separated site names; fallback when no sites exist in the database.
LAGOON_SITES=Emaar,Damac,Nakheel
# Optional: when set, callers must send a matching X-API-Key header.
API_KEY=
