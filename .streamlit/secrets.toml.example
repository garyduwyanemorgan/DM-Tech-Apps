# Copy this file to .streamlit/secrets.toml for local development.
# On Streamlit Community Cloud, paste these values in the Secrets UI
# (App Settings → Secrets).
#
# NEVER commit the real secrets.toml to git.

[supabase]
url = "https://your-project-id.supabase.co"
key = "your-anon-public-key"

# One entry per client site.
# Key   = site name shown in the dashboard dropdown
# Value = password the field team uses to unlock data entry
[site_passwords]
"Site A - Lagoon North" = "change-me-site-a"
"Site B - Lagoon Central" = "change-me-site-b"
"Site C - Lagoon South" = "change-me-site-c"
